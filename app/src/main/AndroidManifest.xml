<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ritregistratie: nauwkeurige route + lokale beeldzoekopdracht (§12.4). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- IN_VEHICLE, ON_BICYCLE en STILL detecteren voor de MotionStateEngine (§5, §12.4). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Langdurige routeopname met zichtbare melding (§12.4). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Foreground-service melding op relevante Android-versies (§12.4). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Beeldbronnen en metadata (§12.4) — vanaf stap 6 (Wikimedia Commons). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HierToenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HierToen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HierToen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
