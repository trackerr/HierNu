<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Toestemmingen voor ritregistratie (ACCESS_FINE_LOCATION, ACTIVITY_RECOGNITION,
        FOREGROUND_SERVICE_LOCATION, POST_NOTIFICATIONS) worden toegevoegd in stap 3
        van de bouwvolgorde (TrackingService), zie technische bouwspecificatie §12.4 en §17.1.
    -->

    <application
        android:name=".HierToenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HierToen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HierToen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
